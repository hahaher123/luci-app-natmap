#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME=natmap
PROG=/usr/bin/$NAME

STATUS_PATH=/var/run/natmap

load_interfaces() {
	config_get interface "$1" interface
	config_get natmap_enable "$1" natmap_enable 1

	[ "${natmap_enable}" = "1" ] && interfaces=" ${interface} ${interfaces}"
}

validate_section_natmap() {
	# 两点都是踩过坑的，改之前先读：
	#
	# ① 末尾的输出重定向不能去掉。uci 的校验器在**校验失败**时会把该 section 的
	#    全部选项值连同每个字段的校验结果打印到 stdout，而 init 脚本的 stdout 会被
	#    procd 收进系统日志 —— notify_telegram_bot_token / link_qb_password /
	#    forward_ikuai_password 这类凭据就会明文出现在 syslog 里。失败告警改由
	#    natmap_instance() 自己写一条不含任何配置值的。
	#
	# ② custom_script_path 不能用 file 类型。自定义脚本是可选功能，路径只在该功能
	#    启用时才有意义；若用 file 校验，「功能关闭 + 路径指向一个已不存在的文件」
	#    会让整个实例被判校验失败 → 实例根本不启动（页面没有外部 IP/端口，日志里
	#    连一行都不属于它），而用户只是没去动那个与当前需求无关的选项。
	#    文件是否存在改到运行时判断（update.sh 里 -r 检查 + 写日志）。
	uci_load_validate "${NAME}" natmap "$1" "$2" \
		'natmap_enable:bool:0' \
		'general_ip_address_family:string' \
		'general_nat_protocol:string' \
		'general_wan_interface:string' \
		'general_wait_network:bool:1' \
		'general_wait_network_timeout:uinteger:120' \
		'general_nat_name:string' \
		'general_interval:uinteger' \
		'general_stun_server:host' \
		'general_http_server:host' \
		'general_bind_port:port' \
		'forward_enable:bool:0' \
		'forward_target_ip:ip4addr' \
		'forward_target_port:port' \
		'forward_mode:string' \
		'forward_firewall_target_interface:string' \
		'forward_ikuai_web_url:string' \
		'forward_ikuai_username:string' \
		'forward_ikuai_password:string' \
		'forward_ikuai_mapping_protocol:string' \
		'forward_ikuai_mapping_wan_interface:string' \
		'forward_advanced_enable:bool:0' \
		'forward_advanced_max_retries:uinteger:10' \
		'forward_advanced_sleep_time:uinteger:3' \
		'notify_enable:bool:0' \
		'notify_mode:string' \
		'notify_telegram_bot_chat_id:string' \
		'notify_telegram_bot_token:string' \
		'notify_telegram_bot_proxy:string' \
		'notify_pushplus_token:string' \
		'notify_serverchan_sendkey:string' \
		'notify_serverchan_advanced_enable:bool:0' \
		'notify_serverchan_advanced_url:string' \
		'notify_gotify_url:string' \
		'notify_gotify_token:string' \
		'notify_gotify_priority:uinteger' \
		'link_enable:bool:0' \
		'link_mode:string' \
		'link_emby_url:string' \
		'link_emby_api_key:string' \
		'link_emby_use_https:bool:0' \
		'link_emby_update_host_with_ip:bool:0' \
		'link_qb_web_url:string' \
		'link_qb_username:string' \
		'link_qb_password:string' \
		'link_qb_allow_ipv6:bool:0' \
		'link_tr_rpc_url:string' \
		'link_tr_username:string' \
		'link_tr_password:string' \
		'link_tr_allow_ipv6:bool:0' \
		'link_cloudflare_token:string' \
		'link_cloudflare_zone_id:string' \
		'link_cloudflare_origin_rule_name:string' \
		'link_cloudflare_redirect_rule_name:string' \
		'link_cloudflare_redirect_rule_target_url:string' \
		'link_cloudflare_ddns_type:string' \
		'link_cloudflare_ddns_domain:host' \
		'link_cloudflare_ddns_ttl:uinteger:60' \
		'link_cloudflare_ddns_https_priority:uinteger:1' \
		'link_cloudflare_ddns_srv_priority:uinteger:1' \
		'link_cloudflare_ddns_srv_weight:uinteger:1' \
		'link_cloudflare_ddns_srv_target_domain:host' \
		'custom_script_enable:bool:0' \
		'custom_script_path:string' \
		>/dev/null 2>&1
}

# 配置校验失败时留痕。校验器的原始输出（含各类凭据）已在上面丢弃，这里只写一句
# 不含任何配置值的话；同时写进页面「执行日志」读的那个文件，让「实例没起来」
# 这件事在页面上就能看见，不必去翻系统日志。
natmap_alert() {
	logger -t natmap "$*" 2>/dev/null
	mkdir -p /var/log/natmap 2>/dev/null
	echo "$(TZ='CST-8' date '+%Y-%m-%d %H:%M:%S') : natmap - $*" \
		>>/var/log/natmap/natmap.log 2>/dev/null
}

natmap_instance() {
	[ "$2" = 0 ] || {
		natmap_alert "实例 $1 配置校验失败, 未启动 (请检查该实例的配置项)"
		return 1
	}

	[ "${natmap_enable}" = 0 ] && return 1

	procd_open_instance "$1"
	# 通过 wait-network.sh 启动：就绪前不启动 natmap，避免开机/网络重置时
	# 因 STUN 不可达连续失败而耗尽 respawn 次数
	procd_set_param command /usr/share/natmap/wait-network.sh "$PROG" \
		${general_interval:+-k "$general_interval"} \
		${general_stun_server:+-s "$general_stun_server"} \
		${general_http_server:+-h "$general_http_server"} \
		${general_bind_port:+-b "$general_bind_port"}

	[ "${general_ip_address_family}" = ipv4 ] && procd_append_param command -4
	[ "${general_ip_address_family}" = ipv6 ] && procd_append_param command -6
	[ "${general_nat_protocol}" = 'udp' ] && procd_append_param command -u

	# 注意：-i 的解析已移到 wait-network.sh，在"网络就绪"之后再解析设备名
	# （init.d 声明实例时网络可能还没起来，那时解析会失败并回落到逻辑接口名，
	# 导致 natmap 绑定到不存在的设备）。
	# 这里仍然声明 netdev，供 procd 检测 WAN 设备重建（PPPoE 重拨等）：
	# ifindex 变化会让实例被认为"配置已变"而重启，从而重新等待就绪并重新打洞。
	[ -n "${general_wan_interface}" ] && {
		local ifname

		network_get_device ifname "$general_wan_interface" || ifname="$general_wan_interface"
		procd_append_param netdev "$ifname"
	}

	# 注意：forward_firewall_target_interface 仅通过 EXTRA_ENV 导出为环境变量
	# 供转发插件使用，不能作为 -i 追加到 natmap 命令行，
	# 否则会覆盖 general_wan_interface 的 -i，导致 natmap 绑定到错误接口。
	[ "${forward_enable}" == 1 ] && [ "${forward_mode}" = natmap ] && [ -n "${forward_target_ip}" ] && procd_append_param command -t "$forward_target_ip" -p "$forward_target_port"
	for e in $EXTRA_ENV; do
		eval value=\$${e}
		option_name=$(echo "$e" | tr 'a-z' 'A-Z')
		if [ -n "$value" ]; then
			# 整体加引号，避免值中含有空格时被拆分成两个参数
			procd_append_param env "$option_name=$value"
		fi
	done

	# console.log "natmap"
	procd_append_param command -e /usr/share/natmap/update.sh

	# respawn 参数：<阈值> <重启间隔> <最大重试次数>
	# 第三项为 0 表示不限次数——网络长时间中断时 natmap 会持续失败，
	# 若沿用默认的 5 次上限，实例会在网络恢复前就彻底停摆（不再拉起），
	# 网络恢复后也不会自己重新打洞。配合 wait-network.sh 的就绪等待，
	# 正常的启动失败已很少发生，这里放开次数上限保证一定能自愈。
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

# ================================================================
# 退役清理：实例被禁用或删除后，它在防火墙里留下的段不会自己退场
# ================================================================
#
# 背景：转发插件把 DNAT / IPv6 放行写成 uci 段之后就撒手了，规则会一直留在
# /etc/config/firewall 和内核里。而 natmap_enable=0 的实例在 natmap_instance()
# 里直接 return 1 —— **压根不交给 procd**，插件再也不会为它跑（实例被整个删掉
# 更是如此）。于是那台内网机的端口映射永久留活：用户以为已经关掉了，外部其实
# 还能打进来。
#
# 这里收走两类段：
#   ① 实例还在、但被禁用 → 删它名下的段
#   ② 实例已被整个删除 → 段成了孤儿，按"防火墙里有、但没有启用实例对应"收走
#
# 判据（宁可不删也不误删）：段名 = slug(实例名) + 固定后缀、段类型为
# redirect / rule、段内 name 等于段名、target 为 DNAT / ACCEPT —— 四条全对上
# 才动。手建的规则一般写中文别名，不会同时满足这四条；像
# firewall.@rule[9].name='natmap incoming' 这类旧一代/外部工具留下的段也不在
# 这条规则内，不会被碰。

_natmap_slug() {
	echo "$1" | sed 's/[^a-zA-Z0-9]/_/g' | awk '{print tolower($0)}'
}

# 按四个判据收走一个段；删掉返回 0，其余情况返回 1（调用方据此决定要不要 reload）
#   $1=段名 $2=期望段类型 $3=期望 target $4=删除原因
_natmap_retire_seg() {
	local n="$1" t="$2" tg="$3" why="$4" cur

	cur=$(uci -q get "firewall.$n" 2>/dev/null)
	[ "$cur" = "$t" ] || return 1
	[ "$(uci -q get "firewall.$n.name" 2>/dev/null)" = "$n" ] || return 1
	[ "$(uci -q get "firewall.$n.target" 2>/dev/null)" = "$tg" ] || return 1

	uci -q delete "firewall.$n" || return 1
	natmap_alert "防火墙退役清理: 已删除 $n ($why) —— 该段原本仍在内核里生效"
	return 0
}

retire_firewall_segments() {
	local changed=0 keep=" " s en nm sg seg suffix

	# ① 仍然启用的实例（缺省即启用）→ 它们的 slug 必须保留
	for s in $(uci -q show natmap 2>/dev/null | sed -n 's/^natmap\.\([^.]*\)=natmap$/\1/p'); do
		en=$(uci -q get "natmap.$s.natmap_enable" 2>/dev/null)
		[ "${en:-1}" = "1" ] || continue
		nm=$(uci -q get "natmap.$s.general_nat_name" 2>/dev/null)
		[ -n "$nm" ] || nm="$s"
		keep="$keep$(_natmap_slug "$nm") "
	done

	# ② 被禁用的实例 → 删它自己的两个段
	for s in $(uci -q show natmap 2>/dev/null | sed -n 's/^natmap\.\([^.]*\)=natmap$/\1/p'); do
		en=$(uci -q get "natmap.$s.natmap_enable" 2>/dev/null)
		[ "${en:-1}" = "1" ] && continue
		nm=$(uci -q get "natmap.$s.general_nat_name" 2>/dev/null)
		[ -n "$nm" ] || nm="$s"
		sg="$(_natmap_slug "$nm")"
		_natmap_retire_seg "${sg}_v4" redirect DNAT "实例 $s 已禁用" && changed=1
		_natmap_retire_seg "${sg}_v6_allow" rule ACCEPT "实例 $s 已禁用" && changed=1
	done

	# ③ 孤儿段：防火墙里有、却没有任何启用实例对应（实例已被整个删除）。
	#    注意 busybox sed 的 BRE 不支持 \| 交替，所以拆成两条替换。
	for seg in $(uci -q show firewall 2>/dev/null \
			| sed -n -e 's/^firewall\.\([^.]*\)=redirect$/\1/p' \
				-e 's/^firewall\.\([^.]*\)=rule$/\1/p'); do
		suffix=""
		case "$seg" in
		*_v6_allow) suffix="_v6_allow" ;;
		*_v4) suffix="_v4" ;;
		*) continue ;;
		esac
		sg="${seg%"$suffix"}"
		# slug 只可能由 _natmap_slug() 生成（小写字母 / 数字 / 下划线）。
		# 别的一律不是本插件建的 —— 手建的段名常带大写或连字符，直接跳过。
		case "$sg" in
		'' | *[!a-z0-9_]*)
			continue
			;;
		esac
		case "$keep" in
		*" $sg "*) continue ;;
		esac
		if [ "$suffix" = "_v4" ]; then
			_natmap_retire_seg "$seg" redirect DNAT "无对应实例(孤儿段)" && changed=1
		else
			_natmap_retire_seg "$seg" rule ACCEPT "无对应实例(孤儿段)" && changed=1
		fi
	done

	[ "$changed" = 1 ] || return 0

	uci commit firewall
	natmap_alert "防火墙退役清理: 配置已提交, 正在重载防火墙使其在内核中退场"
	if ! /etc/init.d/firewall reload 2>/dev/null; then
		/etc/init.d/firewall restart 2>/dev/null \
			|| natmap_alert "防火墙退役清理: 重载与重建都失败 —— 请手动执行 /etc/init.d/firewall restart"
	fi
	return 0
}

clear_status_files() {
	find "${STATUS_PATH}" -type f -print0 | xargs -0 rm -f --
}

# 清理已停止实例遗留的状态 JSON（reload 时 procd 只重启变化的实例，
# 被重启/停止实例的旧 pid JSON 文件会残留，按 pid 进程存活检测清理）
clean_stale_status_files() {
	local file pid

	for file in "${STATUS_PATH}"/*.json; do
		[ -f "$file" ] || continue
		pid="${file##*/}"
		pid="${pid%.json}"
		case "$pid" in
			''|*[!0-9]*)
				continue
				;;
		esac
		kill -0 "$pid" 2>/dev/null || rm -f "$file"
	done
}

service_triggers() {
	local interfaces

	procd_add_reload_trigger "${NAME}"

	config_load "${NAME}"
	config_foreach load_interfaces natmap

	[ -n "${interfaces}" ] && {
		for n in $interfaces; do
			procd_add_reload_interface_trigger $n
		done
	}

	procd_add_validation validate_section_natmap
}

start_service() {
	. /lib/functions/network.sh
	config_cb() {
		[ $# -eq 0 ] && return

		option_cb() {
			local option="$1"

			EXTRA_ENV="$EXTRA_ENV $option"
		}

		list_cb() {
			local name="$1"
			EXTRA_ENV="$EXTRA_ENV $name"
		}
	}
	mkdir -p "${STATUS_PATH}"

	# 退役清理要在声明实例之前跑：被禁用/删除的实例根本不会交给 procd，
	# 它留下的防火墙段只能在这里收走（见 retire_firewall_segments 的注释）。
	retire_firewall_segments

	config_load "${NAME}"
	config_foreach validate_section_natmap natmap natmap_instance
}

# reload 语义：重新声明实例列表，procd 自动做实例级 diff——
# 配置未变的实例保持运行（不打断已打洞的端口），仅
# 新增的实例启动、修改的实例重启、删除/禁用的实例停止。
# 不能用 stop+start：那会把所有规则全部重启、全部重新打洞。
reload_service() {
	start
	# 等待 procd 完成被停止实例的回收，再清理其遗留的状态 JSON
	sleep 1
	clean_stale_status_files
}

service_stopped() {
	clear_status_files
}
