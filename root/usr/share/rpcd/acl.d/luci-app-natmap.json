{
  "luci-app-natmap": {
    "description": "Grant access to LuCI app natmap",
    "read": {
      "file": {
        "/var/run/natmap/*": ["read"],
        "/var/log/natmap/*": ["read"]
      },
      "ubus": {
        "service": ["list"]
      },
      "uci": ["natmap"]
    },
    "write": {
      "file": {
        "/var/log/natmap/*": ["write"]
      },
      "uci": ["natmap"]
    }
  }
}
